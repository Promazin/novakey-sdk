{
  "name": "novakey-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NovaKey SDK - Passkey-native smart wallet toolkit for Stellar and Soroban",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "node --test packages/*/tests/*.test.ts",
    "test:contracts": "cd contracts && cargo test",
    "build:contracts": "cd contracts && cargo build --target wasm32-unknown-unknown --release",
    "example": "node examples/basic-wallet-flow.ts"
  },
  "keywords": [
    "stellar",
    "soroban",
    "passkeys",
    "webauthn",
    "smart-wallet",
    "account-abstraction"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
